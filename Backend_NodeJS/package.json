{
  "name": "backend-nodejs",
  "version": "1.0.0",
  "description": "Backend for Dien Lanh Hong Thai",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "start-node": "tsx watch src/server.ts",
    "start-ai": "cd ../AI_Service_Python && venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "dev": "concurrently -c \"blue.bold,green.bold\" -n \"NODE,PYTHON\" \"npm run start-node\" \"npm run start-ai\"",
    "build": "tsc",
    "db:setup": "tsx scripts/setup-db.ts"
  },
