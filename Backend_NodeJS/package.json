    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "concurrently": "^10.0.4",
