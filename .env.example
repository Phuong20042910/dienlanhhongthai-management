# ============================================================
# Điện Lạnh Hồng Thái Management – Environment Variables
# Sao chép nội dung file này thành file .env.local trong thư mục "web/"
# KHÔNG commit file chứa key thật lên github/mã nguồn mở!
# ============================================================

# ------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Bắt buộc)
# Lấy tại mục: Project Settings -> API trên trang quản trị Supabase
# ------------------------------------------------------------

# Đường dẫn URL của dự án Supabase (Dùng chung cho cả Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Khóa Public (Anon Key) - Dùng an toàn ở phía giao diện (Client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Khóa Bí mật (Service Role Key) - CHỈ dùng ở phía Server (Node.js/Backend), KHÔNG được để lộ ra ngoài!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Điện Lạnh Hồng Thái EMS"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NODE_ENV=development # development | production


# ------------------------------------------------------------
# Ghi chú cho lập trình viên (Developer Notes):
# - Vì chúng ta đã chuyển sang kiến trúc Backend-as-a-Service (Supabase),
#   các cấu hình cũ như DATABASE_URL (raw Postgres), Redis, JWT tự thiết kế, 
#   hay SMTP đều không còn cần thiết nữa vì Supabase đã tự động quản lý.
# ------------------------------------------------------------
